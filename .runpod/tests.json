{
  "tests": [
    {
      "name": "qwen21_smoke",
      "input": {
        "workflow": {
          "unet": {
            "class_type": "UNETLoader",
            "inputs": {
              "unet_name": "qwen_image_2.1_bf16.safetensors",
              "weight_dtype": "default"
            }
          },
          "cache": {
            "class_type": "QwenImage21Cache",
            "inputs": {
              "model": [
                "unet",
                0
              ],
              "device": "auto",
              "dtype": "default"
            }
          },
          "clip": {
            "class_type": "CLIPLoader",
            "inputs": {
              "clip_name": "qwen3vl_8b_bf16.safetensors",
              "type": "qwen_image",
              "device": "default"
            }
          },
          "vae": {
            "class_type": "VAELoader",
            "inputs": {
              "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
            }
          },
          "enc": {
            "class_type": "TextEncodeQwenImage21",
            "inputs": {
              "clip": [
                "clip",
                0
              ],
              "vae": [
                "vae",
                0
              ],
              "prompt": "A plain studio photo of a red apple on a white table.",
              "negative_prompt": "",
              "resolution": 1024
            }
          },
          "sample": {
            "class_type": "KSampler",
            "inputs": {
              "model": [
                "cache",
                0
              ],
              "positive": [
                "enc",
                0
              ],
              "negative": [
                "enc",
                1
              ],
              "seed": 11,
              "steps": 4,
              "cfg": 1.0,
              "sampler_name": "euler",
              "scheduler": "simple",
              "denoise": 1.0,
              "latent_image": [
                "latent",
                0
              ]
            }
          },
          "decode": {
            "class_type": "VAEDecode",
            "inputs": {
              "samples": [
                "sample",
                0
              ],
              "vae": [
                "vae",
                0
              ]
            }
          },
          "save": {
            "class_type": "SaveImage",
            "inputs": {
              "images": [
                "decode",
                0
              ],
              "filename_prefix": "qwen21"
            }
          },
          "latent": {
            "class_type": "EmptySD3LatentImage",
            "inputs": {
              "width": 512,
              "height": 512,
              "batch_size": 1
            }
          }
        }
      },
      "timeout": 600000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA RTX A6000",
    "gpuCount": 1,
    "env": [
      {
        "key": "REFRESH_WORKER",
        "value": "false"
      }
    ],
    "allowedCudaVersions": [
      "13.0",
      "13.1",
      "13.2"
    ]
  }
}
